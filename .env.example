# Copy to backend/.env and edit. NEVER commit the real .env file.

# development | production. In production JWT_SECRET is mandatory (>= 32 chars) and the debugger is off.
APP_ENV=development

# Database. Default (leave empty): SQLite file at ./database/stockghost.db
# PostgreSQL example (install psycopg2-binary first):  postgresql://user:password@localhost:5432/stockghost
DATABASE_URL=

# Secret used to sign login tokens. Generate one:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# In development, if empty, a random secret is generated once and stored in database/.dev_jwt_secret.
JWT_SECRET=
# Token lifetime: 30m, 8h, 7d or seconds
JWT_EXPIRES_IN=8h

# Origin(s) allowed to call the API (comma separated). Must match where the UI is served from.
CLIENT_URL=http://localhost:5173
PORT=5000
# Set to 1 only when running behind a trusted reverse proxy that sets X-Forwarded-For
TRUST_PROXY=0

# Uploads
UPLOAD_LIMIT=25            # max file size in MB
UPLOAD_DIR=                # default: ./uploads  (outside the web root)
MAX_IMPORT_ROWS=200000
MAX_IMPORT_COLUMNS=60

# E-mail for password reset. If SMTP_HOST is empty the reset link is written to the server log instead
# (and returned to the browser only when APP_ENV is not production).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=StockGhost <no-reply@example.com>
